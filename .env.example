# TheWord — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only the YVP_APP_KEY is required for online Bible access.
# Without it, the app runs in offline-only mode using USFM files.

# YouVersion API Key
# Get yours at https://developer.youversion.com
YVP_APP_KEY=
